# Settings of the content check (scripts/check.sh --content; the pre-push hook and the "checks" GitHub Action).
# One entry per line:
#   <exact string>          allowed although it looks like personal data
#   skip: <path or glob>    not scanned
#   block: <path or glob>   must not be committed or sent (for example `block: *.xlsx`)
#   profile: dod            the DoD tier; `denylist: warn` lets a push pass with no name denylist
#   content-max-bytes: <n>  scan text files up to n bytes (default 2000000, at most 50000000; larger ones block in the DoD tier)
#   code-<key>: <value>     a setting of the code standard, for example `code-max-function-lines: 60`
#   audit-<key>: <value>    a setting of the audit, for example `audit-ignore: ref/**`
#                           (the keys and their defaults: the header of scripts/check_settings.py; a `code-` change
#                           needs a docs/DECISIONS.md row that names this file)
# An allowed string or a skip line is added only on the PAM's request, never by an agent to get past a block (AGENTS.md "Guards and checks").
# This project: DoD/M365 data, so the DoD tier and the strict code standard (the PAM, 2026-11-20; docs/DECISIONS.md).
profile: dod
code-max-line-chars: 200
code-c1-safety: on
code-c2: full
code-generated: paste/*.ps1
# Kit 11.0.0 (fleet v2 plan B.4 and DEC 4, 2026-11-23): the kit's strict gate replaces scripts/code_standard_gate.py;
# this is a DoD repo, so the kit's DoD security files sync here.
code-strict-gate: on
dod-security: on
audit-ignore: paste/**
# SharePoint host names: usaf.dps.mil is the site address people type; sharepoint-mil.us is the tenant host (the PAM, 2026-11-20).
sharepoint-mil.us
usaf.dps.mil
# A tool's scan report holds masked PII locations: never commit one (the PAM, 2026-11-20).
block: PIIScan-*
# The published rule source (publicly releasable, the PAM, 2026-11-20): its office mailboxes, .mil links and markings are
# the publication's own text, not project data. The copies are pinned in ref/SHA256SUMS.
skip: ref/afi33-332.txt
skip: ref/afi33-332.pdf
